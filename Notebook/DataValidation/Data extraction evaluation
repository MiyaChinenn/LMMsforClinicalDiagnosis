{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"BWyyNUKUyROj"},"outputs":[],"source":["# --- STEP 1 : Setup ---\n","!pip install PyPDF2 nltk scikit-learn sentence-transformers --quiet\n","\n","import json, re, pandas as pd\n","from google.colab import files\n","from PyPDF2 import PdfReader\n","from sklearn.feature_extraction.text import TfidfVectorizer, ENGLISH_STOP_WORDS\n","from sklearn.metrics.pairwise import cosine_similarity\n","from sentence_transformers import SentenceTransformer, util\n","\n","# Load mini Sentence-BERT for semantic similarity\n","sem_model = SentenceTransformer('all-MiniLM-L6-v2')\n","\n","# --- STEP 2 : Upload Files ---\n","print(\"📄 Upload your PDF file(s):\")\n","uploaded_pdfs = files.upload()\n","\n","print(\"\\n🧾 Upload your JSON file(s):\")\n","uploaded_jsons = files.upload()\n","\n","# --- STEP 3 : Helper Functions ---\n","def extract_text_from_pdf(pdf_path):\n","    \"\"\"Extract plain text from PDF.\"\"\"\n","    reader = PdfReader(pdf_path)\n","    return \" \".join([page.extract_text() or \"\" for page in reader.pages])\n","\n","def preprocess(text):\n","    text = text.lower()\n","    text = re.sub(r'[^a-z0-9\\s]', '', text)\n","    return [w for w in text.split() if w not in ENGLISH_STOP_WORDS]\n","\n","def jaccard_similarity(text1, text2):\n","    s1, s2 = set(preprocess(text1)), set(preprocess(text2))\n","    return len(s1 & s2) / len(s1 | s2) if (s1 | s2) else 0\n","\n","def cosine_text_similarity(text1, text2):\n","    vect = TfidfVectorizer().fit_transform([text1, text2])\n","    return cosine_similarity(vect[0:1], vect[1:2])[0][0]\n","\n","def semantic_similarity(text1, text2):\n","    e1 = sem_model.encode(text1, convert_to_tensor=True)\n","    e2 = sem_model.encode(text2, convert_to_tensor=True)\n","    return float(util.cos_sim(e1, e2))\n","\n","def evaluate_json_vs_pdf(json_data, pdf_text):\n","    \"\"\"Compute completeness + similarity scores.\"\"\"\n","    expected_fields = [\n","        \"patient_information\",\"chief_complaint\",\"history_of_present_illness\",\n","        \"exposure_and_epidemiology\",\"vitals\",\"physical_exam\",\n","        \"labs_and_diagnostics\",\"differential_diagnosis\",\n","        \"management_and_clinical_course\",\"final_diagnosis\"\n","    ]\n","\n","    # Completeness\n","    filled = [f for f in expected_fields if f in json_data and str(json_data[f]).strip()]\n","    completeness = len(filled) / len(expected_fields)\n","\n","    # Combine all extracted text\n","    extracted = \" \".join([json_data.get(f, \"\") for f in expected_fields])\n","\n","    # Metrics\n","    cosine = cosine_text_similarity(pdf_text, extracted)\n","    jaccard = jaccard_similarity(pdf_text, extracted)\n","    semantic = semantic_similarity(pdf_text, extracted)\n","\n","    # Weighted final score\n","    total_score = (0.5*completeness + 0.2*cosine + 0.15*jaccard + 0.15*semantic) * 100\n","\n","    return {\n","        \"Completeness(%)\": round(completeness*100,2),\n","        \"Cosine\": round(cosine,3),\n","        \"Jaccard\": round(jaccard,3),\n","        \"Semantic\": round(semantic,3),\n","        \"Final_Score\": round(total_score,2)\n","    }\n","\n","# --- STEP 4 : Run Evaluation ---\n","results = []\n","\n","for jname, jcontent in uploaded_jsons.items():\n","    data = json.loads(jcontent.decode('utf-8'))\n","\n","    # Match PDF by base name\n","    pdf_name = next((p for p in uploaded_pdfs if p.split('.')[0] in jname), None)\n","    if not pdf_name:\n","        print(f\"⚠️ No matching PDF found for {jname}\")\n","        continue\n","\n","    pdf_text = extract_text_from_pdf(pdf_name)\n","    score = evaluate_json_vs_pdf(data, pdf_text)\n","    score[\"JSON_File\"] = jname\n","    score[\"PDF_File\"] = pdf_name\n","    score[\"Diagnosis\"] = data.get(\"final_diagnosis\",\"N/A\")\n","    results.append(score)\n","\n","# --- STEP 5 : Display and Save ---\n","df = pd.DataFrame(results)\n","print(\"\\n✅ Evaluation Summary:\")\n","display(df)\n","\n","df.to_csv(\"extraction_evaluation_updated.csv\", index=False)\n","print(\"\\n💾 Saved as extraction_evaluation_updated.csv\")\n"]}]}