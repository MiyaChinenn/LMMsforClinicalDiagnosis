se/merged_cases.json\" # 93 cases merged\n","CHAPTERS_DIR = \"/content/drive/MyDrive/[Project25]Colab_Code/Tropical_D_output\"    # 42 cases extracted from the outsource\n","RELEVANT_CHAPTERS_DIR = \"/content/drive/MyDrive/[Project25]Colab_Code/Tropical_D_filter\" # Location save filtered cases that relevant to 93 cases\n","\n","\n","def load_base_diseases(filepath):\n","    \"\"\"Extracts unique disease names from your base cases JSON.\"\"\"\n","    diseases = set()\n","    try:\n","        if not os.path.exists(filepath):\n","            print(f\"Error: Base cases file '{filepath}' not found.\")\n","            return []\n","\n","        with open(filepath, 'r', encoding='utf-8-sig') as f: # utf-8-sig handles BOM\n","            cases = json.load(f)\n","            for case in cases:\n","                # Priority: disease_name_short -> final_diagnosis -> condition\n","                name = case.get(\"disease_name_short\") or case.get(\"final_diagnosis\")\n","                if name:\n","                    # Basic cleanup to remove punctuation/extra spaces\n","                    clean_name = re.sub(r'[^\\w\\s]', '', name).strip()\n","                    diseases.add(clean_name)\n","    except Exception as e:\n","        print(f\"Error reading {filepath}: {e}\")\n","    return list(diseases)\n","\n","def extract_disease_from_chapter(filepath):\n","    \"\"\"\n","    Attempts to read the disease name from inside the chapter JSON.\n","    If specific keys aren't found, it falls back to cleaning the filename.\n","    \"\"\"\n","    try:\n","        with open(filepath, 'r', encoding='utf-8-sig') as f: # utf-8-sig for reliability\n","            try:\n","                data = json.load(f)\n","            except json.JSONDecodeError:\n","                # Fallback if file is empty or malformed\n","                print(f\"Warning: Could not decode JSON in {filepath.name}\")\n","                data = {}\n","\n","            # 1. Try finding explicit disease keys in the JSON content\n","            # (Adjust these keys if your book chapters use different field names)\n","            name = data.get(\"disease_name_short\") or data.get(\"final_diagnosis\") or data.get(\"title\")\n","            if name:\n","                return name\n","\n","    except Exception as e:\n","        print(f\"Error reading chapter file {filepath.name}: {e}\")\n","\n","    # 3. Fallback: Parse the Filename\n","    # Example: \"CHAPTER_XXXVII_Tsutsugamushi.json\" -> \"Tsutsugamushi\"\n","    filename = filepath.name\n","    name = filename.replace(\"CHAPTER_\", \"\").replace(\".json\", \"\")\n","    # Remove Roman numerals (e.g., \"XXXVII_\")\n","    name = re.sub(r'^[IVXLCDM]+_', '', name)\n","    name = name.replace(\"_\", \" \")\n","    return name\n","\n","def check_relevance_with_llm(chapter_disease, base_diseases_list):\n","    \"\"\"\n","    Uses Gemini to semantically compare the chapter's disease against the base list.\n","    \"\"\"\n","    # Convert list to string for the prompt\n","    diseases_str = \", \".join(base_diseases_list)\n","\n","    prompt = f\"\"\"\n","    You are a medical expert in Tropical and Infectious Diseases.\n","\n","    Task: Compare a \"Chapter Topic\" against a list of \"Base Diseases\".\n","    Determine if the Chapter Topic covers the SAME disease, a direct synonym, or a specific form of any disease in the Base List.\n","\n","    Chapter Topic: \"{chapter_disease}\"\n","\n","    Base Diseases List:\n","    [{diseases_str}]\n","\n","    Instructions:\n","    1. Use your medical knowledge to identify synonyms (e.g., \"Sleeping Sickness\" IS \"HAT\", \"Tsutsugamushi\" IS \"Scrub Typhus\", \"Blackwater Fever\" IS \"Malaria\").\n","    2. Return a MATCH if the chapter covers the disease or a direct subtype/complication.\n","    3. Return a JSON object with:\n","       - \"is_relevant\": true or false\n","       - \"matched_base_disease\": The exact name from the Base List it matches (or null).\n","       - \"reason\": A very brief explanation (e.g., \"Synonym for Scrub Typhus\").\n","\n","    Output ONLY valid JSON. Do not use markdown code blocks.\n","    \"\"\"\n","\n","    try:\n","        response = model.generate_content(prompt)\n","        text = response.text.strip()\n","\n","        # Clean markdown code blocks if the model includes them\n","        if text.startswith(\"```json\"):\n","            text = text[7:-3]\n","        elif text.startswith(\"```\"):\n","            text = text[3:-3]\n","\n","        return json.loads(text)\n","    except Exception as e:\n","        print(f\"API Error processing '{chapter_disease}': {e}\")\n","        # Default to False on error to avoid polluting the dataset\n","        return {\"is_relevant\": False, \"reason\": \"API Error\"}\n","\n","def main():\n","    # 1. Setup Folders\n","    if not os.path.exists(CHAPTERS_DIR):\n","        print(f\"Error: Source folder '{CHAPTERS_DIR}' not found. Please create it and add your JSON files.\")\n","        return\n","\n","    if not os.path.exists(RELEVANT_CHAPTERS_DIR):\n","        os.makedirs(RELEVANT_CHAPTERS_DIR)\n","        print(f\"Created output folder: {RELEVANT_CHAPTERS_DIR}\")\n","\n","    # 2. Load Base Diseases\n","    print(\"Loading base diseases from merged_cases.json...\")\n","    base_diseases = load_base_diseases(BASE_CASES_FILE)\n","\n","    if not base_diseases:\n","        print(\"No diseases found in base file. Exiting.\")\n","        return\n","\n","    print(f\"Found {len(base_diseases)} unique base diseases.\")\n","    # print(f\"Examples: {base_diseases[:5]}...\")\n","\n","    # 3. Get Chapter Files\n","    chapter_files = list(Path(CHAPTERS_DIR).glob(\"*.json\"))\n","    if not chapter_files:\n","        print(f\"No .json files found in '{CHAPTERS_DIR}'.\")\n","        return\n","\n","    print(f\"Found {len(chapter_files)} chapter files to process.\")\n","\n","    count_kept = 0\n","\n","    # 4. Process Each Chapter\n","    print(\"-\" * 60)\n","    for i, file_path in enumerate(chapter_files):\n","        # Extract disease name using our smart function (Check JSON content first)\n","        chapter_disease = extract_disease_from_chapter(file_path)\n","\n","        print(f\"[{i+1}/{len(chapter_files)}] Analyzing: {chapter_disease}\")\n","\n","        # Ask Gemini\n","        result = check_relevance_with_llm(chapter_disease, base_diseases)\n","\n","        if result.get(\"is_relevant\"):\n","            match_name = result.get('matched_base_disease')\n","            reason = result.get('reason')\n","            print(f\" MATCH: Maps to '{match_name}' ({reason})\")\n","\n","            # Copy file to the new folder\n","            dest_path = os.path.join(RELEVANT_CHAPTERS_DIR, file_path.name)\n","            shutil.copy2(file_path, dest_path)\n","            count_kept += 1\n","        else:\n","            print(f\" SKIP: {result.get('reason')}\")\n","\n","        # Polite delay to respect API rate limits\n","        time.sleep(5)\n","\n","    print(\"-\" * 60)\n","    print(f\"Filtering Complete.\")\n","    print(f\"Total Chapters Scanned: {len(chapter_files)}\")\n","    print(f\"Relevant Chapters Kept: {count_kept}\")\n","    print(f\"Filtered files are in: {RELEVANT_CHAPTERS_DIR}/\")\n","\n","if __name__ == \"__main__\":\n","    main()"],"metadata":{"id":"EgVleFtAmceu","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1768985138744,"user_tz":-60,"elapsed":472812,"user":{"displayName":"Cuong Luong Tieu","userId":"14112910546502585899"}},"outputId":"63b3cf60-c3b5-4ff0-d408-17df6a1d07ce"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Loading base diseases from merged_cases.json...\n","Found 90 unique base diseases.\n","Found 43 chapter files to process.\n","------------------------------------------------------------\n","[1/43] Analyzing: Malaria\n"," MATCH: Maps to 'Cerebral Malaria' (Cerebral Malaria is a specific, severe form/complication of Malaria.)\n","[2/43] Analyzing: BlackwaterFever\n"," MATCH: Maps to 'Severe Falciparum Malaria' (Blackwater Fever is a severe complication of falciparum malaria, characterized by massive intravascular hemolysis leading to hemoglobinuria.)\n","[3/43] Analyzing: AfricanTrypanosomiasis\n"," MATCH: Maps to 'HAT' (HAT is the acronym for Human African Trypanosomiasis, which is African Trypanosomiasis.)\n","[4/43] Analyzing: Tropical Relapsing Fevers\n"," SKIP: Relapsing Fevers (caused by Borrelia species) are not present in the base list, either as a specific disease or a synonym/subtype of listed diseases.\n","[5/43] Analyzing: YellowFever\n"," MATCH: Maps to 'Yellow Fever' (Direct match.)\n","[6/43] Analyzing: Infectious Jaundice\n"," MATCH: Maps to 'Leptospirosis' (Infectious Jaundice is a widely used term for Weil's disease, the severe icteric form of Leptospirosis.)\n","[7/43] Analyzing: Rat Bite Fever\n"," SKIP: Rat Bite Fever, caused by Streptobacillus moniliformis or Spirillum minus, is not present in the list and is not a direct synonym or specific form of any listed disease.\n","[8/43] Analyzing: Leishmaniases\n"," MATCH: Maps to 'Visceral Leishmaniasis KalaAzar' (Leishmaniases is the plural and general term for diseases caused by Leishmania parasites, which includes specific forms like Visceral Leishmaniasis (Kala-Azar) and Cutaneous Leishmaniasis, both of which are present in the Base Diseases List.)\n","[9/43] Analyzing: Dysentery\n"," MATCH: Maps to 'Amoebic Liver Abscess' (Dysentery commonly includes Amoebic Dysentery, caused by Entamoeba histolytica. Amoebic Liver Abscess is a direct complication of amoebiasis, which manifests as amoebic dysentery.)\n","[10/43] Analyzing: Amoebic Dysentery\n"," MATCH: Maps to 'Amoebic Liver Abscess' (Amoebic dysentery is the intestinal manifestation of Entamoeba histolytica infection, which can lead to the extraintestinal complication of Amoebic Liver Abscess.)\n","[11/43] Analyzing: Liver Abscess\n"," MATCH: Maps to 'Amoebic Liver Abscess' (Amoebic Liver Abscess is a specific form/etiology of liver abscess.)\n","[12/43] Analyzing: BacillaryDysentery\n"," SKIP: Bacillary Dysentery (primarily Shigellosis) is not explicitly listed, nor is it a direct synonym or specific form of any disease in the Base List. Typhoid Fever is caused by Salmonella Typhi, which is distinct.\n","[13/43] Analyzing: Plague\n"," SKIP: The chapter topic 'Plague' is not present in the base list, nor is it a direct synonym or specific form of any listed disease.\n","[14/43] Analyzing: Tularaemia\n"," SKIP: Tularaemia is a distinct bacterial disease caused by Francisella tularensis and is not present in the base list, nor is it a synonym or a specific form/complication of any listed disease.\n","[15/43] Analyzing: Cholera\n"," MATCH: Maps to 'Cholera' (Exact match.)\n","[16/43] Analyzing: MaltaFever\n"," MATCH: Maps to 'Brucellosis' (Synonym for Brucellosis)\n","[17/43] Analyzing: Leprosy\n"," MATCH: Maps to 'Leprosy' (Direct match)\n","[18/43] Analyzing: Beriberi\n"," MATCH: Maps to 'Infantile Beriberi' (Infantile Beriberi is a specific form of Beriberi.)\n","[19/43] Analyzing: Pellagra\n"," MATCH: Maps to 'Pellagra' (Direct match in the Base Diseases List.)\n","[20/43] Analyzing: Sprue\n"," SKIP: Sprue (especially Tropical Sprue) is a malabsorption syndrome and is not a direct synonym, specific form, or complication of any disease in the provided list.\n","[21/43] Analyzing: Ancylostomiasis\n"," MATCH: Maps to 'Cutaneous Larva Migrans' (Cutaneous Larva Migrans is a specific skin manifestation caused by larvae of Ancylostoma species (among others), which are the causative agents of Ancylostomiasis.)\n","[22/43] Analyzing: FilariaBancrofti\n"," MATCH: Maps to 'Lymphatic Filariasis' (Filaria bancrofti refers to Wuchereria bancrofti, the primary causative agent of Lymphatic Filariasis.)\n","[23/43] Analyzing: Schistosomiasis\n"," MATCH: Maps to 'Acute Schistosomiasis Katayama Syndrome' (Chapter topic 'Schistosomiasis' covers this specific form of the disease.)\n","[24/43] Analyzing: Paragonimiasis\n"," MATCH: Maps to 'Paragonimiasis' (Exact match)\n","[25/43] Analyzing: AmoebicDysentery\n"," MATCH: Maps to 'Amoebic Liver Abscess' (Amoebic Dysentery is a common manifestation of Entamoeba histolytica infection, which can lead to Amoebic Liver Abscess.)\n","[26/43] Analyzing: Yaws\n"," MATCH: Maps to 'Yaws' (Direct match)\n","[27/43] Analyzing: Gangosa\n"," MATCH: Maps to 'Yaws' (Gangosa is a late, destructive manifestation of Yaws, primarily affecting the nasopharynx.)\n","[28/43] Analyzing: Mycetoma\n"," SKIP: Mycetoma is a distinct chronic granulomatous disease of skin and subcutaneous tissue, caused by either fungi (eumycetoma) or bacteria (actinomycetoma). It is not a synonym for, nor a specific form of, any disease in the provided list.\n","[29/43] Analyzing: Granuloma Venereum\n"," SKIP: Granuloma Venereum (also known as Donovanosis) is a distinct bacterial sexually transmitted infection not directly listed or represented as a synonym or specific form of any disease in the provided Base Diseases List. While other STIs like Syphilis and Chancroid are listed, Granuloma Venereum is a separate clinical entity caused by Klebsiella granulomatis.\n","[30/43] Analyzing: Tropical Ulcer\n"," MATCH: Maps to 'Yaws' (Yaws, caused by Treponema pertenue, is a key etiological factor in the polymicrobial pathogenesis of Tropical Ulcer.)\n","[31/43] Analyzing: Tinea Imbricata\n"," SKIP: Tinea Imbricata is a superficial dermatophyte fungal infection (a type of dermatophytosis). None of the diseases in the base list are dermatophyte infections; the listed fungal diseases are either subcutaneous, systemic, or opportunistic deep infections.\n","[32/43] Analyzing: TineaCruris\n"," SKIP: Tinea Cruris is a superficial dermatophytosis (fungal infection of the skin), which is not present in the base list. The listed fungal infections (e.g., Chromoblastomycosis, Sporotrichosis, Histoplasmosis, Cryptococcal Meningitis) are either subcutaneous or systemic mycoses, distinct from dermatophytoses.\n","[33/43] Analyzing: Pinta\n"," SKIP: Pinta is a distinct non-venereal treponematosis caused by Treponema carateum, not a synonym or specific form of any disease in the base list.\n","[34/43] Analyzing: Dermatophiliasis\n"," SKIP: Dermatophiliasis, caused by Dermatophilus congolensis, is a distinct bacterial skin infection and is not synonymous with or a specific form of any disease on the provided list.\n","[35/43] Analyzing: OroyaFever\n"," MATCH: Maps to 'Bartonellosis' (Oroya Fever is the acute febrile anemic phase of Bartonellosis, caused by Bartonella bacilliformis.)\n","[36/43] Analyzing: Dengue\n"," MATCH: Maps to 'Dengue' (Direct match)\n","[37/43] Analyzing: Tsutsugamushi\n"," MATCH: Maps to 'Scrub Typhus' (Synonym for Scrub Typhus)\n","[38/43] Analyzing: SpottedFeverOfTheRockyMountains\n"," SKIP: Rocky Mountain Spotted Fever (SpottedFeverOfTheRockyMountains) is a distinct rickettsial disease and not a synonym or specific form of any disease in the provided list. While other rickettsial diseases like Scrub Typhus and African TickBite Fever are listed, RMSF is a separate entity.\n","[39/43] Analyzing: TyphusFever\n"," MATCH: Maps to 'Scrub Typhus' (Scrub Typhus is a specific type of typhus fever.)\n","[40/43] Analyzing: TrenchFever\n"," MATCH: Maps to 'Bartonellosis' (Trench Fever is a specific disease caused by Bartonella quintana, which falls under the broader category of Bartonellosis.)\n","[41/43] Analyzing: Heat Stroke and Heat Prostration\n"," SKIP: Heat Stroke and Heat Prostration are environmental heat-related illnesses and do not match any infectious, parasitic, nutritional, or other specific disease listed in the Base Diseases List.\n","[42/43] Analyzing: ClimaticBubo\n"," SKIP: Climatic Bubo (Granuloma inguinale/Donovanosis) is not present in the list and is not a direct synonym or specific form of any listed disease.\n","[43/43] Analyzing: