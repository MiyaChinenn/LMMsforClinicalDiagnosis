ng a specification of ORIGIN in the DEMOGRAPHIC.\n","Prioritize specifying the LOCATION in the DEMOGRAPHIC.\n","Do NOT make any mentions of medical conditions.\n","\n","FORMAT CONSTRAINT (DO NOT MODIFY CONTENT):\n","Output the DEMOGRAPHIC using the following canonical format.\n","Each attribute MUST follow the pattern: KEY: VALUE\n","\n","Required keys (use exact capitalization):\n","ORIGIN: ; LOCATION: ; ETHNICITY: ; SEX: ; AGE GROUP: .\n","\n","DEMOGRAPHIC:\n","\"\"\"\n","\n","# ---------------- SEX BALANCER ----------------\n","SEX_CYCLE = [\"male\", \"female\"]\n","sex_idx = 0\n","\n","def next_sex():\n","    global sex_idx\n","    sex = SEX_CYCLE[sex_idx]\n","    sex_idx = (sex_idx + 1) % 2\n","    return sex\n","\n","# ---------------- SAFE GENERATE ----------------\n","def safe_generate(prompt, retries=10):\n","    for i in range(1, retries + 1):\n","        try:\n","            return model.generate_content(prompt)\n","        except TooManyRequests:\n","            time.sleep(20 * i)\n","        except ResourceExhausted:\n","            time.sleep(30)\n","    raise RuntimeError(\"Model failed after retries\")\n","\n","# ---------------- DEMOGRAPHIC GENERATOR ----------------\n","def generate_demographic(disease):\n","    sex = next_sex()\n","    prompt = f\"\"\"\n","Before generating the demographic, internally ensure diversity by enforcing:\n","- SEX: {sex}\n","Do not mention this instruction in the output.\n","\"\"\" + DEMOGRAPHIC_SAMPLER_PROMPT.replace(\"<DISEASE>\", disease)\n","\n","    resp = safe_generate(prompt)\n","    return resp.text.replace(\"DEMOGRAPHIC:\", \"\").strip()\n","\n","# ---------------- MAIN ----------------\n","def generate_all_demographics():\n","    for path in sorted(Path(INPUT_DIR).glob(\"*.json\")):\n","        with open(path, \"r\", encoding=\"utf-8\") as f:\n","            data = json.load(f)\n","\n","        disease = data.get(\"diagnosis\") or data.get(\"final_diagnosis\")\n","        if not disease:\n","            continue\n","\n","        out = Path(OUTPUT_DIR) / f\"{disease}.json\"\n","        if out.exists():\n","            print(f\"✔ Skip: {disease}\")\n","            continue\n","\n","        print(f\"Generating demographic for: {disease}\")\n","        demo = generate_demographic(disease)\n","\n","        with open(out, \"w\", encoding=\"utf-8\") as f:\n","            json.dump(\n","                {\"disease\": disease, \"demographic\": demo},\n","                f, ensure_ascii=False, indent=2\n","            )\n","\n","        time.sleep(5)\n","\n","    print(\"DONE: All demographics generated\")\n","\n","# ---------------- RUN ----------------\n","if __name__ == \"__main__\":\n","    generate_all_demographics()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":523},"id":"ScPVkxn56Dq5","executionInfo":{"status":"ok","timestamp":1768985681304,"user_tz":-60,"elapsed":309535,"user":{"displayName":"Cuong Luong Tieu","userId":"14112910546502585899"}},"outputId":"a0a6bb47-8114-452d-bd0f-6e0a7d040fe0"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Generating demographic for: African Trypanosomiasis\n","Generating demographic for: Blackwater Fever\n","Generating demographic for: Dysentery (Symptom-Complex)\n","Generating demographic for: Malaria\n","Generating demographic for: Leishmaniases\n","Generating demographic for: Infectious Jaundice\n","Generating demographic for: Yellow Fever\n","Generating demographic for: Pellagra\n","Generating demographic for: Liver Abscess\n","Generating demographic for: Typhoid Fever\n","Generating demographic for: Trench Fever\n","Generating demographic for: Beriberi\n","Generating demographic for: Malta fever\n","Generating demographic for: Cholera\n","Generating demographic for: Schistosomiasis\n","Generating demographic for: Filaria bancrofti infection\n","Generating demographic for: Paragonimiasis\n","Generating demographic for: Ancylostomiasis\n","Generating demographic for: Gangosa\n","Generating demographic for: Yaws or Framboesia\n","Generating demographic for: Amoebic dysentery\n","Generating demographic for: Typhus Fever\n","Generating demographic for: Tsutsugamushi\n","Generating demographic for: Dengue\n","Generating demographic for: Oroya Fever\n","Generating demographic for: Tropical Ulcer\n","Generating demographic for: Amoebic Dysentery\n","DONE: All demographics generated\n"]}]},{"cell_type":"markdown","source":["### Create QA - old version"],"metadata":{"id":"_ISp7pVndTUg"}},{"cell_type":"code","source":["import json\n","import time\n","import re\n","from pathlib import Path\n","\n","# ---------------- CONFIG ----------------\n","INPUT_DIR = \"/content/drive/MyDrive/Tropical_D_filter(1)\"\n","DEMO_DIR = \"/content/drive/MyDrive/Tropical_D_PI\"\n","OUTPUT_FILE = \"/content/drive/MyDrive/rawTestQA.json\"\n","BATCH_SIZE = 3\n","\n","# ---------------- LOAD EXISTING QA ----------------\n","if Path(OUTPUT_FILE).exists():\n","    with open(OUTPUT_FILE, \"r\", encoding=\"utf-8\") as f:\n","        results = json.load(f)\n","    done_diseases = {x[\"disease_specific_focus\"] for x in results}\n","else:\n","    results = []\n","    done_diseases = set()\n","\n","# ---------------- HELPERS ----------------\n","def build_scenario(case, demographic_info=None):\n","    parts = []\n","\n","    if demographic_info:\n","        parts.append(f\"Patient Demographics: {demographic_info.strip()}\")\n","\n","    for k in [\n","        \"history_of_present_illness\",\n","        \"exposure_and_epidemiology\",\n","        \"vitals\",\n","        \"physical_exam\",\n","        \"labs_and_diagnostics\",\n","        \"differential_diagnosis\",\n","        \"management_and_clinical_course\",\n","    ]:\n","        v = case.get(k, \"\")\n","        if v and v != \"not reported\":\n","            parts.append(v.strip())\n","\n","    return \" \".join(parts)\n","\n","\n","def extract_json(text: str) -> dict:\n","    \"\"\"\n","    Robustly extract the first JSON object from LLM output.\n","    Works regardless of markdown fences or extra text.\n","    \"\"\"\n","    match = re.search(r\"\\{[\\s\\S]*\\}\", text)\n","    if not match:\n","        raise ValueError(\"No JSON object found in model output\")\n","    return json.loads(match.group())\n","\n","\n","def make_qa_prompt(case_id, scenario, disease_name, source_filename):\n","    \"\"\"\n","    Synthesizes the case into a Medical CoT format\n","    (Patient Description + Clinical Rationale).\n","    \"\"\"\n","    prompt = f\"\"\"\n","You are an expert clinician-educator. Your task is to transform raw clinical data\n","into a high-quality Diagnostic QA pair with a detailed Clinical Rationale (Chain-of-Thought).\n","\n","You MUST FIRST generate a patient DEMOGRAPHIC description by strictly following the instructions below.\n","You MUST internally generate the DEMOGRAPHIC exactly according to these rules,\n","but you must NOT output it as a separate field.\n","Instead, you must integrate the demographic information naturally into the clinical vignette.\n","\n","### DEMOGRAPHIC GENERATION INSTRUCTIONS (DO NOT MODIFY):\n","{DEMOGRAPHIC_SAMPLER_PROMPT.replace(\"<DISEASE>\", disease_name)}\n","\n","### INPUT DATA:\n","- Reference Disease: {disease_name}\n","- Source Chapter: {source_filename}\n","- Raw Clinical Scenario: {scenario}\n","\n","### TASK:\n","Construct a JSON object with the following fields:\n","\n","1. \"question\":\n","   Synthesize a cohesive clinical vignette. You MUST include:\n","   - Demographics: Age and Sex.\n","   - Context: Location, Origin.\n","   - Risk Factors: Lifestyle, habits, exposures, and specific risk factors from the data.\n","   - Presentation: Integrate symptoms, vital signs, and physical examination findings\n","     into a professional prose narrative.\n","   - Ending: You must end the description with the question:\n","     \"What is the diagnosis of this patient?\"\n","\n","2. \"answer\":\n","   Given the {disease_name} with necessary modifiers (subtype, form, stage, complication).\n","\n","3. \"disease_specific_focus\":\n","   Output the fundamental {disease_name} WITHOUT modifiers.\n","\n","4. \"clinical_rationale\":\n","   Provide a multi-step diagnostic reasoning (Chain-of-Thought).\n","   - Analyze how the patient's age, location, and specific risk factors\n","     (lifestyle/exposure) increase the likelihood of {disease_name}.\n","   - Explain the pathophysiological link between the clinical findings\n","     (symptoms/signs) and the diagnosis.\n","   - Briefly mention why competing diagnoses are less likely\n","     based on the evidence provided.\n","   - Conclude with the phrase:\n","     \"Final Diagnosis: {disease_name}\"\n","\n","5. \"source_file\":\n","   Output the source chapter name: {source_filename}.\n","\n","### FORMAT:\n","Return ONLY a valid JSON object:\n","{{\n","  \"question\": \"...\",\n","  \"answer\": \"...\",\n","  \"disease_specific_focus\": \"...\",\n","  \"clinical_rationale\": \"...\",\n","  \"source_file\": \"{source_filename}\"\n","}}\n","\"\"\"\n","    return prompt.strip()\n","\n","# ---------------- MAIN ----------------\n","def generate_qa_batch():\n","    count = 0\n","    files = sorted(Path(INPUT_DIR).glob(\"*.json\"))\n","\n","    for path in files:\n","        if count >= BATCH_SIZE:\n","            break\n","\n","        with open(path, \"r\", encoding=\"utf-8\") as f:\n","            case_data = json.load(f)\n","\n","        disease = case_data.get(\"diagnosis\") or case_data.get(\"final_diagnosis\")\n","        if not disease or disease in done_diseases:\n","            continue\n","\n","        demo_path = Path(DEMO_DIR) / f\"{disease}.json\"\n","        if not demo_path.exists():\n","            continue\n","\n","        with open(demo_path, \"r\", encoding=\"utf-8\") as f:\n","            demo_data = json.load(f)\n","\n","        scenario = build_scenario(case_data, demo_data[\"demographic\"])\n","\n","        prompt = make_qa_prompt(\n","            case_id=0,\n","            scenario=scenario,\n","            disease_name=disease,\n","            source_filename=path.name,\n","        )\n","\n","        print(f\"Generating QA for: {disease}\")\n","        resp = safe_generate(prompt)\n","\n","        try:\n","            qa = extract_json(resp.text)\n","        except Exception as e:\n","            print(\"Failed to parse model output for:\", disease)\n","            print(\"Raw output (first 1000 chars):\")\n","            print(repr(resp.text[:1000]))\n","            raise e\n","\n","        results.append(qa)\n","        done_diseases.add(disease)\n","\n","        count += 1\n","        time.sleep(2)\n","\n","    with open(OUTPUT_FILE, \"w\", encoding=\"utf-8\") as f:\n","        json.dump(results, f, ensure_ascii=False, indent=2)\n","\n","    print(f\"DONE batch: {count} diseases\")\n","\n","\n","if __name__ == \"__main__\":\n","    generate_qa_batch()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":88},"id":"x8qqEfSOtrli","executionInfo":{"status":"ok","timestamp":1767376425713,"user_tz":-420,"elapsed":23887,"user":{"displayName":"Ngoc Nguyen Hoang Yen","userId":"05688370784560024411"}},"outputId":"dafceb5c-9b6b-4a64-a273-c934ed64370b"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Generating QA for: African Trypanosomiasis\n","Generating QA for: Blackwater Fever\n","Generating QA for: Malaria\n","DONE batch: 3 diseases\n"]}]},{"cell_type":"code","source":["import json\n","import time\n","import re\n","from pathlib import Path\n","from google.api_core import exceptions\n","\n","# ---------------- CONFIG ----------------\n","INPUT_DIR = \"/content/drive/MyDrive/Tropical_D_filter(1)\"\n","OUTPUT_FILE = \"/content/drive/MyDrive/rawTestQA.json\"\n","TEST_BATCH_SIZE = 3  # <--- LIMIT SỐ LƯỢNG FILE CẦN TEST\n","\n","# ---------------- DEMOGRAPHIC PROMPT ----------------\n","DEMOGRAPHIC_SAMPLER_PROMPT = \"\"\"\n","Generate a realistic patient DEMOGRAPHIC description based on one or more of the following:\n","ORIGIN, LOCATION, ETHNICITY, SEX, AGE GROUP.\n","In the patient DEMOGRAPHIC, for ORIGIN, consider specific regions where the <DISEASE> is highly prevalent.\n","In the patient DEMOGRAPHIC, for LOCATION, consider specific towns or provinces within the selected ORIGIN where the <DISEASE> is\n","highly prevalent.\n","In the patient DEMOGRAPHIC, consider ETHNICITY amongst those living locally at the selected ORIGIN where the <DISEASE> is highly\n","prevalent, as well as those likely to be traveling at the ORIGIN. Make ETHNICITY as specific as possible.\n","In the patient DEMOGRAPHIC, balancely choose SEX among male or female.\n","In the patient DEMOGRAPHIC, balance choose AGE GROUP among young, elderly, child, adolescent, middle-aged, adult. For WOMEN also\n","must pre-menopausal, post-menopausal. Also must defining AGE GROUP above or below a certain AGE.\n","\n","Do NOT make any claims about the DEMOGRAPHIC, do NOT output a sentence.\n","Prioritize including a specification of ORIGIN in the DEMOGRAPHIC.\n","Prioritize specifying the LOCATION in the DEMOGRAPHIC.\n","Do NOT make any mentions of medical conditions.\n","\n","DEMOGRAPHIC:\n","\"\"\"\n","\n","# ---------------- HELPERS ----------------\n","def build_scenario(case, demographic_info=None):\n","    parts = []\n","\n","    if demographic_info:\n","        parts.append(f\"Patient Demographics: {demographic_info.strip()}\")\n","\n","    for k in [\n","        \"history_of_present_illness\",\n","        \"exposure_and_epidemiology\",\n","        \"vitals\",\n","        \"physical_exam\",\n","        \"labs_and_diagnostics\",\n","        \"differential_diagnosis\",\n","        \"management_and_clinical_course\",\n","    ]:\n","        v = case.get(k, \"\")\n","        if v and v != \"not reported\":\n","            parts.append(v.strip())\n","\n","    return \" \".join(parts)\n","\n","\n","def roman_to_int(s: str) -> int:\n","    roman_map = {\"I\": 1, \"V\": 5, \"X\": 10, \"L\": 50, \"C\": 100, \"D\": 500, \"M\": 1000}\n","    result = 0\n","    prev = 0\n","\n","    for c in reversed(s):\n","        val = roman_map.get(c, 0)\n","        result = result - val if val < prev else result + val\n","        prev = val\n","\n","    return result\n","\n","\n","def get_case_id_from_filename(path: Path, default_id: int) -> int:\n","    match = re.search(r\"CHAPTER_([IVXLCDM]+)_\", path.stem)\n","    if match:\n","        try:\n","            return roman_to_int(match.group(1))\n","        except Exception:\n","            return default_id\n","    return default_id\n","\n","\n","def safe_generate(prompt, max_retries=5):\n","    \"\"\"\n","    Assumes 'model' is already initialized in your environment (e.g. GenerativeModel).\n","    \"\"\"\n","    for attempt in range(max_retries):\n","        try:\n","            return model.generate_content(prompt)\n","        except exceptions.ResourceExhausted:\n","            print(\"Quota exceeded, waiting 30s...\")\n","            time.sleep(30)\n","        except Exception as e:\n","            print(f\"Gen Error (attempt {attempt}): {e}\")\n","            time.sleep(5)\n","    raise RuntimeError(\"Max retries exceeded\")\n","\n","\n","def generate_demographics(disease_name: str) -> str:\n","    prompt = DEMOGRAPHIC_SAMPLER_PROMPT.replace(\"<DISEASE>\", disease_name)\n","    resp = safe_generate(prompt)\n","    return resp.text.replace(\"DEMOGRAPHIC:\", \"\").strip()\n","\n","\n","# --------- ROBUST JSON EXTRACTION ---------\n","\n","def extract_json(text: str) -> dict:\n","    \"\"\"\n","    Robustly extract the first JSON object from LLM output.\n","    Returns a Python Dictionary.\n","    \"\"\"\n","    # Tìm pattern JSON object\n","    match = re.search(r\"\\{[\\s\\S]*\\}\", text)\n","    if not match:\n","        raise ValueError(\"No JSON object found in model output\")\n","\n","    # Parse string thành dict ngay tại đây\n","    return json.loads(match.group())\n","\n","\n","def make_qa_prompt(case_id, scenario, disease_name, source_filename):\n","    prompt = f\"\"\"\n","You are an expert clinician-educator. Your task is to transform raw clinical data\n","into a high-quality Diagnostic QA pair with a detailed Clinical Rationale (Chain-of-Thought).\n","\n","You MUST FIRST generate a patient DEMOGRAPHIC description by strictly following the instructions below.\n","You MUST internally generate the DEMOGRAPHIC exactly according to these rules,\n","but you must NOT output it as a separate field.\n","Instead, you must integrate the demographic information naturally into the clinical vignette.\n","\n","### DEMOGRAPHIC GENERATION INSTRUCTIONS (DO NOT MODIFY):\n","{DEMOGRAPHIC_SAMPLER_PROMPT.replace(\"<DISEASE>\", disease_name)}\n","\n","### INPUT DATA:\n","- Reference Disease: {disease_name}\n","- Source Chapter: {source_filename}\n","- Raw Clinical Scenario: {scenario}\n","\n","### TASK:\n","Construct a JSON object with the following fields:\n","\n","1. \"question\":\n","   Synthesize a cohesive clinical vignette. You MUST include:\n","   - Demographics: Age and Sex.\n","   - Context: Location, Origin.\n","   - Risk Factors: Lifestyle, habits, exposures, and specific risk factors from the data.\n","   - Presentation: Integrate symptoms, vital signs, and physical examination findings\n","     into a professional prose narrative.\n","   - Ending: You must end the description with the question:\n","     \"What is the diagnosis of this patient?\"\n","\n","2. \"answer\":\n","   Given the {disease_name} with necessary modifiers (subtype, form, stage, complication).\n","\n","3. \"disease_specific_focus\":\n","   Output the fundamental {disease_name} WITHOUT modifiers.\n","\n","4. \"clinical_rationale\":\n","   Provide a multi-step diagnostic reasoning (Chain-of-Thought).\n","   - Analyze how the patient's age, location, and specific risk factors\n","     (lifestyle/exposure) increase the likelihood of {disease_name}.\n","   - Explain the pathophysiological link between the clinical findings\n","     (symptoms/signs) and the diagnosis.\n","   - Briefly mention why competing diagnoses are less likely\n","     based on the evidence provided.\n","   - Conclude with the phrase:\n","     \"Final Diagnosis: {disease_name}\"\n","\n","5. \"source_file\":\n","   Output the source chapter name: {source_filename}.\n","\n","### FORMAT:\n","Return ONLY a valid JSON object:\n","{{\n","  \"question\": \"...\",\n","  \"answer\": \"...\",\n","  \"disease_specific_focus\": \"...\",\n","  \"clinical_rationale\": \"...\",\n","  \"source_file\": \"{source_filename}\"\n","}}\n","\"\"\"\n","    return prompt.strip()\n","\n","# ---------------- MAIN ----------------\n","def generate_QA_dataset():\n","    results = []\n","    # Tìm tất cả file\n","    all_json_files = sorted(Path(INPUT_DIR).glob(\"*.json\"))\n","\n","    # --- BATCH LIMIT LOGIC ---\n","    if TEST_BATCH_SIZE and len(all_json_files) > TEST_BATCH_SIZE:\n","        json_files = all_json_files[:TEST_BATCH_SIZE]\n","        print(f\"⚠️ TESTING MODE: Processing first {TEST_BATCH_SIZE} files out of {len(all_json_files)}.\")\n","    else:\n","        json_files = all_json_files\n","        print(f\"Processing all {len(json_files)} files.\")\n","    # -------------------------\n","\n","    for idx, path in enumerate(json_files, start=1):\n","        with open(path, \"r\", encoding=\"utf-8\") as f:\n","            case_data = json.load(f)\n","\n","        disease = (\n","            case_data.get(\"diagnosis\")\n","            or case_data.get(\"final_diagnosis\")\n","            or \"Unknown\"\n","        )\n","\n","        print(f\"[{idx}/{len(json_files)}] Processing: {disease} | File: {path.name}\")\n","\n","        raw_text = \"\" # Init để tránh lỗi khi print exception\n","\n","        try:\n","            # 1. Generate Demographic info first\n","            demo = generate_demographics(disease)\n","\n","            # 2. Build full scenario text\n","            scenario = build_s